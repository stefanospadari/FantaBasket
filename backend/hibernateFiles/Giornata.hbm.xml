<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"hibernateFiles/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
  <class name="model.Giornata" table="giornata">
    <id name="id" column="idgiornata" />
    <property name="numeroGiornata" column="numerogiornata"/>
    <property name="calcolabile" column="calcolabile"/>
    <set name="scontriDiretti" table="scontridiretti" inverse="false" lazy="true" fetch="select">
     <key><column name="idgiornata"></column></key>
     <one-to-many class="model.ScontroDiretto"/>
    </set>
  </class>
</hibernate-mapping>